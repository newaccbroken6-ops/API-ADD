{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/add-profile",
      "dest": "/api/add-profile.js"
    },
    {
      "src": "/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/regions",
      "dest": "/api/regions.js"
    },
    {
      "src": "/get-access-token",
      "dest": "/api/get-access-token.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/add-profile.js"
    }
  ]
}